# Region: na | eu | au | azure-na | azure-eu | gcp-na | gcp-eu  (or a full API host, e.g. eu-api.contentstack.com)

# --- SOURCE stack (copy from) ---
SOURCE_REGION=eu
SOURCE_API_KEY=
SOURCE_MANAGEMENT_TOKEN=
SOURCE_BRANCH=main

# --- TARGET stack (copy to) ---
TARGET_REGION=eu
TARGET_API_KEY=
TARGET_MANAGEMENT_TOKEN=
TARGET_BRANCH=main

# API version for global fields (3.2 = nested global fields support). Leave empty to disable.
GLOBAL_FIELDS_API_VERSION=3.2

PORT=3000

# --- Panel sessions (credentials entered in the panel are kept in server memory only) ---
# Forget credentials after this many hours of inactivity / at the latest after this many hours.
SESSION_IDLE_HOURS=8
SESSION_MAX_HOURS=24

# --- Running on a shared server (default: localhost only) ---
# HOST=0.0.0.0
# ALLOWED_HOSTS=toolkit.example.com
# Behind an HTTPS reverse proxy: trust X-Forwarded-Proto so the session cookie gets the Secure flag.
# TRUST_PROXY=1
# Or force the Secure flag: COOKIE_SECURE=1
